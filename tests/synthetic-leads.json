                 "message": "Water is coming through the ceiling after last night's storm.", "honeypot": "" },
      "expect": { "guard": "pass", "score": "HOT", "status": "replied", "reply_mode": "ai", "replies_sent": 1 }
    },
    {
      "id": "T003", "workflow": "A", "client_slug": "abc-roofing",
      "title": "AU missing urgency -> WARM, reply asks about timing",
      "input": { "submission_id": "t003-sub", "name": "Mike Brown", "email": "mike.brown@example.com", "phone": "+61400000003",
