                 "service": "gutter repair", "postcode": "", "urgency": "this_week", "property_type": "house",
                 "message": "Gutter is hanging off the side of the house.", "honeypot": "" },
      "expect": { "guard": "pass", "score": "WARM", "missing_fields": ["postcode"], "status": "replied", "replies_sent": 1,
                  "reply_asks_about": "postcode" }
    },
    {
      "id": "T005", "workflow": "A", "client_slug": "abc-roofing",
