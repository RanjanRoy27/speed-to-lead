      "expect": { "guard": "pass_then_llm_reject", "reject_reason": "spam", "score": "COLD", "status": "rejected", "replies_sent": 0, "llm_calls": 1 }
    },
    {
      "id": "T009", "workflow": "A", "client_slug": "abc-roofing",
      "title": "Out of scope: pool resurfacing sent to a roofer",
      "input": { "submission_id": "t009-sub", "name": "Greg Hall", "email": "greg.hall@example.com", "phone": "+61400000009",
                 "service": "other", "postcode": "4101", "urgency": "this_week", "property_type": "house",
                 "message": "I need my swimming pool resurfaced and re-tiled.", "honeypot": "" },
      "expect": { "guard": "pass_then_llm_reject", "reject_reason": "out_of_scope", "score": "COLD", "status": "rejected", "replies_sent": 0, "llm_calls": 1 }
    },
    {
      "id": "T010", "workflow": "A", "client_slug": "abc-roofing",
      "title": "Idempotency: same submission_id sent twice (double click / webhook retry)",
      "repeat_input_of": "T001", "send_times": 2,
      "expect": { "leads_created": 1, "replies_sent": 1, "second_attempt_event": "idempotent_skip" }
    },
    {
      "id": "T011", "workflow": "A", "client_slug": "abc-roofing",
      "title": "Same person submits again 10 minutes later (new submission_id)",
