                 "service": "roof repair", "postcode": "4101", "urgency": "this_week", "property_type": "house",
                 "message_generator": { "repeat": "My roof has a leak near the chimney. ", "times": 215 }, "honeypot": "" },
      "expect": { "guard": "pass", "score": "HOT", "replies_sent": 1, "llm_input_chars_max": 4000, "raw_payload_keeps_full_message": true }
    },
    {
      "id": "T017", "workflow": "A", "client_slug": "abc-roofing",
      "title": "LLM timeout -> fallback template, still fast",
