{
  "version": "1",
  "description": "Synthetic inquiries for the Speed-to-Lead PoC. All data is fictional. Send each case to the intake webhook with is_test=true and test_case_id=<id>. Workflow B cases replay a booking webhook.",
  "defaults": {
    "test_clock_local": "2026-10-07T10:00:00",
    "note": "Wednesday 10:00 in the client's timezone, i.e. inside business hours. Only honored when is_test=true, via raw_payload._test.clock_local, so results do not depend on when you run the suite. t_received stays real so latency numbers stay honest."
  },
  "invariants": [
    "A lead never receives more than one outbound first reply.",
    "A rejected lead never receives an outbound message.",
    "Every lead has an events row for lead_received/lead_inserted unless the case is idempotent_skip.",
    "response_ms < 60000 for every replied lead, including fallback replies.",
    "No outbound message contains a currency symbol, 'free', 'discount' or 'guarantee'.",
    "Re-running the same submission_id never creates a second lead."
  ],
  "cases": [
    {
      "id": "T001", "workflow": "A", "client_slug": "abc-roofing",
      "title": "AU normal HOT lead",
      "input": { "submission_id": "t001-sub", "name": "John Smith", "email": "john.smith@example.com", "phone": "+61400000001",
                 "service": "roof repair", "postcode": "4101", "urgency": "this_week", "property_type": "house",
                 "message": "Hi, I need my roof repaired this week. There is a cracked tile above the garage.", "honeypot": "" },
      "expect": { "guard": "pass", "score": "HOT", "status": "replied", "reply_mode": "ai", "replies_sent": 1, "is_after_hours": false }
    },
    {
      "id": "T002", "workflow": "A", "client_slug": "abc-roofing",
      "title": "AU emergency",
      "input": { "submission_id": "t002-sub", "name": "Sarah Nguyen", "email": "sarah.nguyen@example.com", "phone": "+61400000002",
