      "input": { "submission_id": "t011-sub", "name": "John Smith", "email": "john.smith@example.com", "phone": "+61400000001",
                 "service": "roof repair", "postcode": "4101", "urgency": "emergency", "property_type": "house",
                 "message": "Any update? It is getting worse.", "honeypot": "" },
      "expect": { "guard": "reject", "reject_reason": "duplicate", "duplicate_of": "T001", "status": "rejected", "replies_sent": 0,
                  "inbound_message_appended_to": "T001" }
    },
    {
      "id": "T012", "workflow": "A", "client_slug": "abc-roofing",
      "title": "After-hours HOT lead is still answered within 60 s",
      "force": { "clock_local": "2026-10-06T23:30:00" },
      "input": { "submission_id": "t012-sub", "name": "Olivia Park", "email": "olivia.park@example.com", "phone": "+61400000012",
                 "service": "roof repair", "postcode": "4104", "urgency": "this_week", "property_type": "house",
                 "message": "Found a leak late at night, can someone come this week?", "honeypot": "" },
      "expect": { "guard": "pass", "score": "HOT", "is_after_hours": true, "status": "replied", "replies_sent": 1,
