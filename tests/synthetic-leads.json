      "expect": { "guard": "pass", "score": "HOT", "replies_sent": 1 }
    },
    {
      "id": "T016", "workflow": "A", "client_slug": "abc-roofing",
      "title": "Very long message (8,000 chars) does not break intake or the LLM call",
