                 "service": "roof repair", "postcode": "ABCD", "urgency": "this_week", "property_type": "house",
                 "message": "Roof tiles slipping.", "honeypot": "" },
      "expect": { "guard": "pass", "postcode_area": null, "score": "WARM", "missing_fields": ["postcode"], "replies_sent": 1 }
