                 "message": "Cracked ridge capping.", "honeypot": "" },
      "expect": { "guard": "pass", "score": "HOT", "reply_mode": "fallback", "llm_calls_status": "invalid_json", "status": "replied", "replies_sent": 1 }
    },
    {
