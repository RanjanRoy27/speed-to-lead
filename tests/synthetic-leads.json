                 "message": "Looking at getting the roof checked.", "honeypot": "" },
      "expect": { "guard": "pass", "score": "WARM", "missing_fields": ["urgency"], "status": "replied", "replies_sent": 1,
                  "reply_asks_about": "timing" }
    },
    {
      "id": "T004", "workflow": "A", "client_slug": "abc-roofing",
