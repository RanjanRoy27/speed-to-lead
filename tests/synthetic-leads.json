    {
      "id": "T024", "workflow": "B", "client_slug": "abc-roofing",
      "title": "Booking created -> matched to lead by attendee email",
      "depends_on": "T001",
      "webhook": { "payload_shape": "ILLUSTRATIVE - capture one real Cal.com webhook, replace this, and keep the case.",
