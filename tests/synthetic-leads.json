                 "service": "roof replacement", "postcode": "2000", "urgency": "flexible", "property_type": "house",
                 "message": "Quote for a full roof replacement please.", "honeypot": "" },
      "expect": { "guard": "reject", "reject_reason": "out_of_area", "score": "COLD", "status": "rejected", "reply_mode": "none", "replies_sent": 0, "llm_calls": 0 }
