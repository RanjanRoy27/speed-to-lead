      "expect": { "guard": "pass", "score": "HOT", "replies_sent": 1, "reply_language": "fr", "reply_contains_booking_url_times": 1 }
    },
    {
      "id": "T015", "workflow": "A", "client_slug": "abc-roofing",
      "title": "Empty free-text message, structured fields complete",
      "input": { "submission_id": "t015-sub", "name": "Noah Webb", "email": "noah.webb@example.com", "phone": "+61400000015",
