                  {
                      "parameters":  {
                                         "jsCode":  "const input = $json.body ?? $json;\nconst slug = String(input.client_slug ?? \u0027abc-roofing\u0027).trim();\nconst email = input.email ? String(input.email).trim().toLowerCase() : null;\nconst phone = input.phone ? String(input.phone).trim() : null;\nif (!email \u0026\u0026 !phone) throw new Error(\u0027Provide email or phone\u0027);\nconst urgencyRaw = String(input.urgency ?? \u0027\u0027).trim().toLowerCase();\nconst allowed = [\u0027emergency\u0027,\u0027this_week\u0027,\u0027flexible\u0027,\u0027unknown\u0027];\nconst urgency = allowed.includes(urgencyRaw) ? urgencyRaw : \u0027unknown\u0027;\nconst submission = input.submission_id ? String(input.submission_id).trim() : null;\nconst payload = {...input};\nreturn [{json:{client_slug:slug, source:String(input.source ?? \u0027web_form\u0027), external_id:submission, received_at:new Date().toISOString(), name:input.name ? String(input.name).trim() : null, email, phone, service:input.service ? String(input.service).trim() : null, postcode:input.postcode ? String(input.postcode).trim() : null, urgency, property_type:input.property_type ? String(input.property_type).trim() : null, message:String(input.message ?? \u0027\u0027).slice(0,4000), honeypot:String(input.honeypot ?? \u0027\u0027), is_test:Boolean(input.is_test), test_case_id:input.test_case_id ?? null, raw_payload:JSON.stringify(payload)}}];"
                                     },
                      "id":  "a-normalize",
                      "name":  "Normalize and validate",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
