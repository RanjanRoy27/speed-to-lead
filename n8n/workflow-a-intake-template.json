                                   ]
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "WITH cfg AS (SELECT id, country FROM client_config WHERE slug=$1 AND is_active=true), ins AS (INSERT INTO leads (client_id,source,external_id,raw_payload,is_test,test_case_id,name,email,phone,country,service,postcode,urgency,property_type,t_received) SELECT cfg.id,$2,$3,$4::jsonb,$5,$6,$7,$8,$9,cfg.country,$10,$11,$12,$13,$14::timestamptz FROM cfg ON CONFLICT (client_id,source,external_id) DO NOTHING RETURNING id,client_id), msg AS (INSERT INTO messages (lead_id,direction,channel,author,body,delivery_status) SELECT id,\u0027inbound\u0027,\u0027web_form\u0027,\u0027lead\u0027,$15,\u0027received\u0027 FROM ins RETURNING lead_id), ev AS (INSERT INTO events (lead_id,client_id,workflow,step,status,detail) SELECT id,client_id,\u0027intake\u0027,\u0027lead_inserted\u0027,\u0027ok\u0027,jsonb_build_object(\u0027external_id\u0027,$3) FROM ins RETURNING id) SELECT (SELECT id FROM ins) AS lead_id, (SELECT count(*) FROM ins) AS inserted;",
                                         "options":  {
                                                         "queryReplacement":  "={{ $json.client_slug }},={{ $json.source }},={{ $json.external_id }},={{ $json.raw_payload }},={{ $json.is_test }},={{ $json.test_case_id }},={{ $json.name }},={{ $json.email }},={{ $json.phone }},={{ $json.service }},={{ $json.postcode }},={{ $json.urgency }},={{ $json.property_type }},={{ $json.received_at }},={{ $json.message }}"
                                                     }
                                     },
